# Development calls /api/v1 through the Vite proxy (same origin).
VITE_API_BASE_URL=/api/v1
# Change to the PORT in api/.env if the API does not run on 3000.
API_PROXY_TARGET=http://localhost:3000
# Cloudflare Pages: keep VITE_API_BASE_URL=/api/v1 and set API_ORIGIN
# in Pages Settings > Variables and Secrets (server-side, no /api/v1 suffix).
# See ../docs/deploy-cloudflare.md. API_PROXY_TARGET is only for Vite dev.
# Direct API calls only when frontend and API share the same site:
# VITE_API_BASE_URL=https://api.diary.example.com/api/v1
