NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
# Optional: Swagger origin for auth requests. Local default follows http://localhost:<PORT>.
# SWAGGER_ORIGIN=https://api.diary.example.com
DATABASE_URL=postgresql://diary:diary@localhost:5432/private_diary
# Neon CLI writes both URLs into the repo root .env.local (loaded automatically).
# DATABASE_URL: pooled app traffic; DATABASE_URL_UNPOOLED: direct Prisma migrations.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=Q6UXMhpPeF2RQciOBt5SVRjmm2abGlpWkZ3x0O9ahp6IWkGvv3qX8ADFostQg5M0
JWT_ISSUER=private-diary-api
JWT_AUDIENCE=private-diary-web
# Development can use local private files. Production requires r2 + secure cookies.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.data/images
COOKIE_SECURE=false
TRUST_PROXY=false
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
